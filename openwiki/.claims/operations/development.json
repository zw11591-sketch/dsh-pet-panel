    {
      "id": "claim_85bb4d3e3965493b9f763d40586f922c",
      "statement": "There is no repository-authored automated test suite: there are no `*.test.ts`/`*.spec.ts` files in `src/` or `scripts/`, and no `vitest`/`jest` config; the `*.test.ts` hits in the repo belong to `node_modules` dependencies. Verification of a change is the type gate (`pnpm run typecheck`), the build (`pnpm run build`), and running the loaded plugin.",
      "evidence": [
