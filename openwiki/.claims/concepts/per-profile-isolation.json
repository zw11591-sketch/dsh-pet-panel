    {
      "id": "claim_e264baf2872342d7b22a75d0aecde112",
      "statement": "profileNameFromArgv() derives the active profile from process.argv by parsing --profile <name> or --profile=<name>, which is the only reliable profile signal because dsh does not chdir into the profile directory and does not expose it to plugins.",
      "evidence": [
        {
          "resource": "repo://src/index.ts#L566-L578",
          "version": "repo-lines-v1:sha256:82a299fe918c08e17951114060302e7f59459685aa6c071fca5464df485d6c3b:"
