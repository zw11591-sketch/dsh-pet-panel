    {
      "id": "claim_ad20d5dfded84f23a741a90e35b9cc21",
      "statement": "Every profile surface path is built through dshHomePath() from @deepseek-ai/dsh-home-paths, which joins segments onto a single resolved dsh home (DSH_HOME or ~/.dsh), so all profile data stays under one home root regardless of launch cwd.",
      "evidence": [
