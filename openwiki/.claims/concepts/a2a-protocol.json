    {
      "id": "claim_e69e2fcf4ba647ca876fc4e3b081b920",
      "statement": "The A2A domain model in src/index.ts is three interfaces: A2ACard ({ name, description, capabilities }), A2AExternalAgent ({ name, url, description, capabilities, keywords?, examples? }), and A2AConfig ({ card, agents }), where url is the external agent's agent-card endpoint and keywords/examples are routing hints normalized to empty arrays before persistence.",
      "evidence": [
        {
          "resource": "repo://src/index.ts#L539-L564",
          "version": "repo-lines-v1:sha256:69629fd3469a2063e2d0d9b49b8a05e47910966d25513d333c57e77caa0ba6b4:"
        }
      ]
    },
    {
      "id": "claim_cd66cd427b15413786cdbeac62d8b46f",
      "statement": "The A2A registry is the plugin's third per-profile data surface, persisted as a2a-agents.json under join(a2aConfigDir(), 'a2a-agents.json'), where a2aConfigDir() returns dshHomePath('profiles', profile) when --profile is present in process.argv and otherwise falls back to DSH_PROFILE_DIR, a cordis.yml-bearing cwd, then the global home.",
      "evidence": [
        {
          "resource": "repo://src/index.ts#L585-L598",
          "version": "repo-lines-v1:sha256:7bd0e63a0f88c75231e9529b41fbd6fe7702e4a26c34a19daf13450f9f355980:"
