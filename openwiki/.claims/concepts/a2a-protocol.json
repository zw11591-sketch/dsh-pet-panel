    {
      "id": "claim_d80c1e84b5f540c5bce45bcfc12e4381",
      "statement": "When resolveAgent() returns null, a2a_call does not throw; it returns a candidate-closure reply listing every registered agent's name and description with an empty agent field, so the model can self-correct on the next tool call instead of the request failing hard.",
