    {
      "id": "claim_1262c6d42cc94c51ad848d10ce3a6c7d",
      "statement": "resolveAgent() resolves an external agent through an exact → normalized → substring → Levenshtein chain and returns only a unique match; normalized matching lowercases and strips spaces/hyphens/underscores/interpuncts, substring matching is case-insensitive containment in either direction, and Levenshtein keeps candidates within max(2, floor(norm.length/3)) returning the unique lowest score.",
      "evidence": [
        {
          "resource": "repo://src/index.ts#L761-L810",
