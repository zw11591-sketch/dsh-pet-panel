    {
      "id": "claim_15b0a03178bc4d64b24b166875d27757",
      "statement": "dsh-pet-panel is a single npm package that mounts into a DeepSeek Harness web profile as two separately-built faces: a Node host half (lib/index.js built from src/index.ts, exposing cordis Gateways and Typert remotes) and a browser client half (lib/client.js built from src/client/index.ts, applying slot components). The packaging contract in package.json maps \".\" to the host bundle and \"./client\" to the browser bundle.",
      "evidence": [
        {
          "resource": "repo://package.json#L28-L41",
          "version": "repo-lines-v1:sha256:ca801db927b024fc7509b7851833326d6d9bf0de289e84c54fe857e518568f21:"
        },
        {
