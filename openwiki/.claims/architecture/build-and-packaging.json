    {
      "id": "claim_5b00d16f0f1349c3bcd5c10a8beec394",
      "statement": "Two regexes carve out what a client bundle may inline: INLINE_SAFE (`@deepseek-ai/dsh-(host-apiproxy|session|llm|tools|brand)`) for browser-safe wire contract surfaces with no shared runtime identity, and GENERATED_REMOTE (`@deepseek-ai/dsh-*/remote`) for generated descriptor/codec contributions with no shared runtime identity.",
      "evidence": [
