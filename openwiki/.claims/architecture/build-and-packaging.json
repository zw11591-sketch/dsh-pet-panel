    {
      "id": "claim_ccfb25c62ea647bc9c4feab1a000acb3",
      "statement": "The dsh-client-bundle-purity resolveId plugin is a build-time mirror of the module-edge rules: it rejects every @deepseek-ai value import that is neither a platform external (CLIENT_EXTERNALS) nor an inline-safe wire layer, since a cross-plugin value import either inlines a duplicate runtime instance or requires a specifier the frozen module table cannot answer; cross-plugin collaboration goes through cordis services instead, and type-only imports are erased before reaching the gate.",
      "evidence": [
        {
          "resource": "repo://build/tsdown.client.ts#L265-L281",
          "version": "repo-lines-v1:sha256:946d0b5b7ddbca49e4bd17efc8d3b069e3680a49d22f2c5324965ced1f7e3d42:"
        }
