    {
      "id": "claim_ab88e973a7a64369b5b0bd71d29e634b",
      "statement": "Every skill name reaching the filesystem in the skillForge namespace is validated by assertName() against NAME_RE (/^[A-Za-z0-9_-]{1,64}$/) before join() appends the single segment and the fixed SKILL.md filename, so a read/write/delete call like read('../other') is rejected and can never escape the skill root.",
      "evidence": [
        {
          "resource": "repo://src/index.ts#L14-L35",
          "version": "repo-lines-v1:sha256:90fd900758d30c497714294ad25c4334e8f85da1913c7e0e02fef0e77a1edd0d:"
        }
      ]
    },
    {
      "id": "claim_17ff4c337f0649d288b1fab39e9d0226",
      "statement": "skillRoot() resolves the active profile from process.argv via profileNameFromArgv and returns dshHomePath('profiles', <profile>, 'skills') when a profile is active, else dshHomePath('skills'), so each skill lives at <skillRoot>/<name>/SKILL.md scoped to the active profile.",
      "evidence": [
