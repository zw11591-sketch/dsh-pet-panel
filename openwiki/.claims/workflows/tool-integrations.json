    {
      "id": "claim_aed34594d56543b0aee92ba405071531",
      "statement": "The sidebar list renders liveness visually with a per-server mounted indicator — `已挂载` vs `未挂载` — driven by the `mounted` field that `list()` returns, so the user can see which configured servers' tools are actually available to the agent. `save` and `remove` both `await refresh()` after the RPC so the sidebar reflects the new mounted state.",
      "evidence": [
        {
          "resource": "repo://src/client/ToolIntegrationsView.tsx#L149-L167",
          "version": "repo-lines-v1:sha256:f95abdbd001b6eb8966bccc4d4b6289c4b62d493808d0de43855773a88b95f9a:"
