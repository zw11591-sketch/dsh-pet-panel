    },
    {
      "id": "claim_1f050f57a878459da87f82de5138e52b",
      "statement": "The remote wire codec `mcpConfig` mirrors the host `McpConfig` shape: `transport` is `z.enum(['stdio', 'streamable-http'])` and `command`/`args`/`env`/`cwd`/`url`/`headers` are all `.optional()`. The list item extends the config with an optional-free liveness flag — `mcpListItem = mcpConfig.extend({ mounted: z.boolean() })` — so `list` results cross the boundary without needing the `compact()` de-`undefined` stripping used by the lifecycle path.",
      "evidence": [
        {
          "resource": "repo://src/client/remote.ts#L62-L75",
          "version": "repo-lines-v1:sha256:4b9536bce56f0dad6d2c5ea8bbddc54e1e080b4eed997929c89d56c87bb581c2:"
        }
      ]
    }
